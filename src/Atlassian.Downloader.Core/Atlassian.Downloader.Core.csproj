<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>EpicMorg.Atlassian.Downloader</PackageId>
    <Version>1.0.0.4</Version>
    <Authors>EpicMorg, kasthack, stam, EpicMorgDev</Authors>
    <Description>Core library for downloading Atlassian products and plugins.</Description>
    <PackageProjectUrl>https://github.com/EpicMorg/atlassian-downloader</PackageProjectUrl>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EpicMorg.Atlassian.Downloader</Title>
    <Copyright>EpicMorg</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EpicMorg/atlassian-downloader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>epicmorg, atlassian, tool, downloader</PackageTags>
    <AssemblyTitle>Atlassian Downloader</AssemblyTitle>
    <Company>EpicMorg</Company>
    <Product>Atlassian Downloader</Product>
    <PackageIcon>favicon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- MIT asks nothing of the consumer, so there is nothing to accept. Leaving this on made
         NuGet prompt for license acceptance on install. -->
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack="false": as a Content item this shipped into the package four times over, once under
         content/ and once per target framework under contentFiles/, which is 436KB of a 1.1MB
         package, and NuGet then copied it into every consuming project. The package icon is
         favicon.png (PackageIcon above); this one only exists for ApplicationIcon, which a library
         does not use anyway. -->
    <Content Include="favicon.ico" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="favicon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	<!-- signtool.exe ships with the Windows SDK and exists nowhere else, so this target has to stay
	     off other platforms. Without the guard a Release build on Linux or macOS died here with
	     exit code 127 even though every assembly had already been produced. -->
	<Target Name="SignLibraryOutput" AfterTargets="Build" Condition=" '$([MSBuild]::IsOSPlatform(Windows))' == 'true' ">
		<PropertyGroup>
			<CertificateThumbprint>3baa227ad0dba8db55d0efa14b74aa56b689601d</CertificateThumbprint>
			<TimestampServerUrl>http://timestamp.digicert.com</TimestampServerUrl>
		</PropertyGroup>

		<Message Text="Signing library output: $(TargetPath)" Importance="high" Condition=" '$(Configuration)' == 'Release' " />

		<Exec Command="signtool.exe sign /sm /sha1 &quot;$(CertificateThumbprint)&quot; /tr &quot;$(TimestampServerUrl)&quot; /td sha256 /fd sha256 &quot;$(TargetPath)&quot;" Condition=" '$(Configuration)' == 'Release' and '$(CertificateThumbprint)' != '' and Exists('$(TargetPath)')" />
	</Target>

</Project>